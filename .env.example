# Copy this file to .env and fill in LLM_API_KEY. .env is gitignored.
# The model layer is an OpenAI-compatible adapter: these three variables are the
# only thing that changes between providers.

# --- Default: Google Gemini free tier (OpenAI-compatible endpoint) ---
# Free key: https://aistudio.google.com/apikey
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=your-gemini-key-here
LLM_MODEL=gemini-flash-latest

# --- Production swap: Grok via the xAI API (same API shape) ---
# Comment out the three lines above and uncomment these three. No code changes.
# LLM_BASE_URL=https://api.x.ai/v1
# LLM_API_KEY=your-xai-key-here
# LLM_MODEL=grok-4.7

# --- Optional ---
# PORT=3000                 # approval server port
# LLM_TIMEOUT_MS=60000      # per-request timeout
# LLM_MAX_RETRIES=4         # retries on HTTP 429 / 5xx (free tiers rate-limit)
